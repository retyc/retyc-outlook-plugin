{
  "name": "retyc-outlook-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Outlook Add-in for Retyc — secure, end-to-end encrypted file transfers",
  "author": "TripleStack SAS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retyc/retyc-outlook-plugin.git"
  },
  "homepage": "https://retyc.com",
  "bugs": {
    "url": "https://github.com/retyc/retyc-outlook-plugin/issues"
  },
  "keywords": [
    "outlook",
    "office-addin",
    "retyc",
    "file-transfer",
    "encryption",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --watch --mode development",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "start": "vite --mode development",
    "dev:setup": "node scripts/dev-setup.js",
    "clean": "rm -rf dist .certs manifest.dev.xml"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@nuxt/ui": "^4.11.3",
    "@retyc/sdk": "1.1.0-beta1",
    "buffer": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.143",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/office-js": "^1.0.611",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
