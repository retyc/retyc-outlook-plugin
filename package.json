{
  "name": "retyc-outlook-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Outlook Add-in for Retyc — secure, end-to-end encrypted file transfers",
  "author": "TripleStack SAS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retyc/retyc-outlook-plugin.git"
  },
  "homepage": "https://retyc.com",
  "bugs": {
    "url": "https://github.com/retyc/retyc-outlook-plugin/issues"
  },
  "keywords": [
    "outlook",
    "office-addin",
    "retyc",
    "file-transfer",
    "encryption",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --watch --mode development",
    "lint": "eslint src",
    "typecheck": "vue-tsc --noEmit",
    "start": "vite --mode development",
    "dev:setup": "node scripts/dev-setup.js",
    "clean": "rm -rf dist .certs manifest.dev.xml"
  },
  "dependencies": {
    "@nuxt/ui": "^4.7.1",
    "@retyc/sdk": "^1.0.2",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/lucide": "^1.2.105",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.1",
    "@types/node": "^25.6.0",
    "@types/office-js": "^1.0.589",
    "@vitejs/plugin-vue": "^6.0.6",
    "buffer": "^6.0.3",
    "eslint": "^10.3.0",
    "path-browserify": "^1.0.1",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vue-tsc": "^3.2.7"
  }
}
