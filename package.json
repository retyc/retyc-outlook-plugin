{
  "name": "retyc-outlook-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Outlook Add-in for Retyc — secure, end-to-end encrypted file transfers",
  "author": "TripleStack SAS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retyc/retyc-outlook-plugin.git"
  },
  "homepage": "https://retyc.com",
  "bugs": {
    "url": "https://github.com/retyc/retyc-outlook-plugin/issues"
  },
  "keywords": [
    "outlook",
    "office-addin",
    "retyc",
    "file-transfer",
    "encryption",
    "e2e"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "start": "webpack serve --mode development",
    "dev:setup": "node scripts/dev-setup.js",
    "clean": "rm -rf dist .certs manifest.dev.xml"
  },
  "dependencies": {
    "@retyc/sdk": "^1.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/office-js": "^1.0.589",
    "buffer": "^6.0.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "html-webpack-plugin": "^5.6.7",
    "mini-css-extract-plugin": "^2.10.2",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
